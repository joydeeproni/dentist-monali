# Admin dashboard password
ADMIN_PASSWORD=change-me-to-something-secure

# Secret used to sign JWT tokens
ADMIN_SECRET=change-me-to-a-random-string

# Vercel Blob token — required in production so admin edits and image
# uploads persist (the serverless filesystem is read-only). Auto-injected
# by Vercel when a Blob store is connected to the project. Leave unset
# locally to read/write the bundled data/site-content.json instead.
BLOB_READ_WRITE_TOKEN=
